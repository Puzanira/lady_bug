    \u0445\u043E\u0440\u043E\u0448\u0435\u0435, \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044C
    \u043F\u043B\u043E\u0445\u043E\u0435, \u0432\u0434\u0432\u043E\u0451\u043C \u2014
    \u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0440\u044E\u043A\u0438\n\n\u0426\u0415\u041B\u042C\n\u041F\u0440\u043E\u0431\u0435\u0436\u0430\u0442\u044C
    100 \u043A\u043C \u0437\u0430 \u0441\u0430\u043C\u043E\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043D\u0430\u0431\u0438\u0440\u0430\u044F \u043E\u0447\u043A\u0438, \u0442\u0440\u044E\u043A\u0438
    \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\n\n\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415\n\u041F\u0440\u0430\u0432\u044B\u0439:
    \u2190 \u2192 \u043F\u043E\u043B\u043E\u0441\u0430, \u2191 \u043F\u0440\u044B\u0436\u043E\u043A,
    \u2193 \u043F\u0440\u0438\u0433\u043D\u0443\u0442\u044C\u0441\u044F\n\u041B\u0435\u0432\u044B\u0439:
    A D \u043F\u043E\u043B\u043E\u0441\u0430, W \u043F\u0440\u044B\u0436\u043E\u043A,
    S \u043F\u0440\u0438\u0433\u043D\u0443\u0442\u044C\u0441\u044F\n\u0413\u0430\u0437\u0430
    \u0438 \u0442\u043E\u0440\u043C\u043E\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435\u0442 \u2014 \u0434\u043E\u0440\u043E\u0433\u0430 \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441\u0430\u043C\u0430, \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
    \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442\n\n\u0422\u0420\u042E\u041A\u0418\n\u0410\u0420\u041A\u0410:
    \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u0441\u0435\u0434\u0430\u0435\u0442
    \u043F\u043E\u0434 \u0430\u0440\u043A\u043E\u0439, \u0434\u0440\u0443\u0433\u043E\u0439
    \u0432 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0442
    \u0435\u0451 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C\n\u041A\u041E\u041B\u042C\u0426\u041E:
    \u0438\u0433\u0440\u043E\u043A\u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438
    \u2014 \u043E\u0434\u0438\u043D \u0432 \u043F\u0440\u044B\u0436\u043A\u0435,
    \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043E\u043D\u0438\u0437\u0443\n\n\u0414\u0410\u0422\u0427\u0418\u041A\u0418
    \u0420\u0410\u0421\u0421\u0422\u041E\u042F\u041D\u0418\u042F\n2 \u0434\u0430\u0442\u0447\u0438\u043A\u0430
    \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 \u2014 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443
    \u043D\u0430 \u0440\u0443\u043A\u0443 (\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0440\u0445/\u043D\u0438\u0437):\n\u043E\u0431\u0435
    \u0440\u0443\u043A\u0438 \u0432\u043D\u0438\u0437 \u2014 \u043F\u0440\u0438\u0433\u043D\u0443\u0442\u044C\u0441\u044F,
    \u043E\u0434\u043D\u0430 \u0432\u0432\u0435\u0440\u0445/\u0434\u0440\u0443\u0433\u0430\u044F
    \u0432\u043D\u0438\u0437 \u2014 \u043F\u043E\u043B\u043E\u0441\u0430 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u043E\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0439 \u0440\u0443\u043A\u0438,\n\u0431\u044B\u0441\u0442\u0440\u043E
    \u0436\u0430\u0442\u044C \xAB\u0432\u0435\u0440\u0445\xBB \u043D\u0430 \u043E\u0431\u0435\u0438\u0445
    \u0440\u0443\u043A\u0430\u0445 \u0440\u0430\u0437\u043E\u043C \u2014 \u043F\u0440\u044B\u0436\u043E\u043A-\u043F\u043E\u043B\u0451\u0442\n\n\u0412\u042B\u0425\u041E\u0414
    \u0418\u0417 \u0418\u0413\u0420\u042B\n\u0412\u0441\u0435 \u0438\u0433\u0440\u043E\u043A\u0438
    \u0440\u0430\u0437\u043E\u043C \u0434\u0435\u0440\u0436\u0430\u0442 \xAB\u043F\u0440\u0438\u0433\u043D\u0443\u0442\u044C\u0441\u044F\xBB
    10 \u0441\u0435\u043A\u0443\u043D\u0434 \u2014 \u043F\u043E\u0441\u043B\u0435
    \u043F\u0435\u0440\u0432\u044B\u0445 5 \u043C\u043E\u043B\u0447\u0430, \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    5 \u0441 \u043E\u0431\u0440\u0430\u0442\u043D\u044B\u043C \u043E\u0442\u0441\u0447\u0451\u0442\u043E\u043C
    \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435"
